# ════════════════════════════════════════════════════════════════
# Tamasha - Security & Production .gitignore
# ════════════════════════════════════════════════════════════════

# ─── Secrets & Environment (CRITICAL) ───────────────────────────
.env
.env.*
*.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample

# Streamlit secrets
.streamlit/secrets.toml
.streamlit/secrets.toml.local
!.streamlit/secrets.toml.example
!.streamlit/secrets.toml.template

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
kaggle.json
credentials.json
client_secret*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.publishsettings

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ─── Byte-compiled / optimized / DLL files ─────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
.venv*/
env.bak/
venv.bak/

# ─── Data files (large, raw, and processed) ────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ─── Model artifacts ───────────────────────────────────────────
models/*.pkl
models/*.joblib
models/*.onnx
models/*.json
models/**/*.pkl
models/**/*.joblib
models/**/*.onnx
models/**/*.json
!models/.gitkeep
catboost_info/

# ─── Distribution / packaging ──────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.python-version

# ─── IDE / Editor ──────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
.idea/
*.swp
*.swo
*~
*.code-workspace

# ─── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak

# ─── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ─── Reports ───────────────────────────────────────────────────
reports/*.html
reports/*.png

# ─── Docker ────────────────────────────────────────────────────
.docker/

# ─── Testing / CI / Coverage ───────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
.coverage.xml
htmlcov/
coverage/
.tox/
.nox/
radar_balance.txt

# ─── Type checking ─────────────────────────────────────────────
.mypy_cache/
.pytype/
.typings/
.dmypy.json

# ─── Node.js ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Logs & Database Files ─────────────────────────────────────
*.log
logs/
*.dump
*.stackdump
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
tmp/
temp/

# =====================================================================
# KEEP: AI provenance & transparency files — must remain visible
# =====================================================================
!AI_DISCLOSURE.md
!AI_USAGE.md
!PROMPTS.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.github/copilot-instructions.md
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/settings.json
!docs/ai/
!docs/ai/**
!.ai/
!.ai/**
!ai-provenance.json
!.gitmessage
!CITATION.cff
